# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Security
JWT_SECRET=your_jwt_secret_key_here

# Seed Users (scripts/seedUsers.js)
SEED_USER_1_USERNAME=your_seed_user_1_username
SEED_USER_1_PASSWORD=your_seed_user_1_password
SEED_USER_2_USERNAME=your_seed_user_2_username
SEED_USER_2_PASSWORD=your_seed_user_2_password
SEED_USER_3_USERNAME=your_seed_user_3_username
SEED_USER_3_PASSWORD=your_seed_user_3_password
SEED_USER_4_USERNAME=your_seed_user_4_username
SEED_USER_4_PASSWORD=your_seed_user_4_password

# Test Authentication (scripts/test_auth_fix.js)
TEST_AUTH_USERNAME=your_test_username
TEST_AUTH_PASSWORD=your_test_password

# Email Service (test_email.js)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
